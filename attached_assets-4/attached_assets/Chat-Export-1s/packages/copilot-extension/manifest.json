{
  "manifest_version": 3,
  "name": "Clientum Copilot",
  "version": "0.1.0",
  "description": "Asistente IA para agentes humanos en WhatsApp Web — powered by Clientum CRM",
  "permissions": ["storage", "clipboardWrite", "clipboardRead"],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "https://*.replit.app/*",
    "https://*.replit.dev/*",
    "https://*.repl.co/*",
    "http://localhost:*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Clientum Copilot"
  }
}
